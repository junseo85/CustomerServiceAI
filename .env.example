SECRET_KEY=change-me
# Any OpenAI-compatible chat completions endpoint. Required for AI chat and translation. Set AI_MOCK=1 only for offline testing (no real translation).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DATABASE=issues.db
# Set to 1 to seed demo users (employee/it/qa/manager, password "password")
SEED_DEMO=1
# Use HOST=0.0.0.0 so other devices on the LAN can connect (see README)
HOST=127.0.0.1
PORT=5000
