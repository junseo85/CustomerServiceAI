SECRET_KEY=change-me
# Any OpenAI-compatible chat completions endpoint. Leave OPENAI_API_KEY empty to use the offline mock AI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Speech-to-text model; the configured provider must support audio/transcriptions.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
DATABASE=issues.db
# Set to 1 to seed demo users (employee/it/qa/manager, password "password")
SEED_DEMO=1
UPLOAD_DIR=uploads
# Optional; leave unset for models that reject custom temperature
#OPENAI_TEMPERATURE=0.2
